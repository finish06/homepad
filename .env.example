# Homepad self-host configuration. Every setting is optional except
# POSTGRES_PASSWORD.
#
# Quickstart (published images, no checkout): see the top of compose.yaml.
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)" > .env && docker compose up -d
# Building from source instead:
#   cp .env.example .env && docker compose -f compose.build.yaml up --build -d
#
# Image version for the quickstart (defaults to the release compose.yaml pins).
# HOMEPAD_VERSION=17.0.0
#
# .env is gitignored; never commit real secrets. Every value below has a safe
# dev default EXCEPT POSTGRES_PASSWORD, which you must set.

# --- Postgres ------------------------------------------------------------
# The one value you must change. User/DB have working defaults.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_USER=homepad
POSTGRES_DB=homepad
# The api's DATABASE_URL is assembled from the three values above by compose
# (postgres://USER:PASSWORD@postgres:5432/DB?sslmode=disable) — no need to set it
# here. Only override it if you point the api at an external Postgres.

# --- Web ------------------------------------------------------------------
# Host port the dashboard is served on → http://localhost:${HOMEPAD_WEB_PORT}
HOMEPAD_WEB_PORT=8080

# --- API build source -----------------------------------------------------
# The Go backend lives in a separate repo; compose builds it from here. Default
# is the public GitHub repo. For a local checkout use a path (both repos cloned
# side by side): HOMEPAD_API_CONTEXT=../homepad-api
HOMEPAD_API_CONTEXT=https://github.com/finish06/homepad-api.git#main

# --- Sessions / cookies ---------------------------------------------------
# COOKIE_SECURE MUST be false for plain-HTTP localhost or login won't stick.
# Set it true only when serving Homepad over HTTPS (e.g. behind a TLS proxy).
COOKIE_SECURE=false
# Opaque session secret (32+ random bytes). Rotating it logs everyone out.
SESSION_SECRET=change-me-to-32-random-bytes

# --- Registration policy --------------------------------------------------
#   open         — anyone can self-register (default; register the first
#                  account, which becomes admin, then switch to invite_only)
#   invite_only  — only an admin can create new accounts
HOMEPAD_REGISTRATION=open

# --- Gatus (status tiles) -------------------------------------------------
# Where the api polls status from. Leave empty to run without status dots.
# Quickstart: COMPOSE_PROFILES=gatus starts a bundled Gatus; then set
# GATUS_BASE_URL=http://gatus:8080 and edit the gatus-config block in compose.yaml.
# compose.build.yaml always runs Gatus, configured by deploy/compose/gatus.yaml.
# COMPOSE_PROFILES=gatus
GATUS_BASE_URL=http://gatus:8080
# A check that SUCCEEDED but took longer than this reads DEGRADED ("Slow" on the
# tile). 0 disables the derivation.
GATUS_DEGRADED_MS=1000
# Override the Gatus image/tag if you prefer Docker Hub (twinproduction/gatus).
GATUS_IMAGE=ghcr.io/twin/gatus:latest

# --- OIDC / SSO (OPTIONAL) ------------------------------------------------
# Homepad runs fully on local accounts with OIDC_ENABLED=false. To enable SSO,
# set it true and fill in your provider's values; leave them blank otherwise.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_ADMIN_GROUP=
