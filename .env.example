# Homepad self-host configuration. Every setting is optional except
# POSTGRES_PASSWORD.
#
# Quickstart (published images, no checkout): see the top of compose.yaml.
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 16)" > .env && docker compose up -d
# Building from source instead:
#   cp .env.example .env && docker compose -f compose.build.yaml up --build -d
#
# Image version for the quickstart (defaults to the release compose.yaml pins).
# HOMEPAD_VERSION=18.3.0
#
# .env is gitignored; never commit real secrets. Every value below has a safe
# dev default EXCEPT POSTGRES_PASSWORD, which you must set.
#
# Admins can change the cookie, proxy, Gatus, sign-up, account-limit and
# OIDC settings in Admin Panel → System, with no restart. A value saved there
# wins over this file; Reset in the panel goes back to it.

# --- Postgres ------------------------------------------------------------
# The one value you must change. User/DB have working defaults.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_USER=homepad
POSTGRES_DB=homepad
# The api's DATABASE_URL is assembled from the three values above by compose
# (postgres://USER:PASSWORD@postgres:5432/DB?sslmode=disable) — no need to set it
# here. Only override it if you point the api at an external Postgres.

# --- Widgets (OPTIONAL) ---------------------------------------------------
# Encrypts the API keys you give widgets (AES-256-GCM): 64 hex characters.
# Make one with:  echo "HOMEPAD_SECRET_KEY=$(openssl rand -hex 32)" >> .env
# Without it, the clock, weather and web search still work. Back it up with
# your database: if it changes, saved keys must be entered again.
# See docs/widgets.md.
HOMEPAD_SECRET_KEY=

# --- Recovery -------------------------------------------------------------
# true: ignore every server setting saved in Admin Panel → System and use this file.
# HOMEPAD_SETTINGS_FROM_ENV_ONLY=true

# --- Web ------------------------------------------------------------------
# Host port the dashboard is served on → http://localhost:${HOMEPAD_WEB_PORT}
HOMEPAD_WEB_PORT=8080

# --- API build source -----------------------------------------------------
# Used only by compose.build.yaml. The Go API is in api/ in this repo, which
# is the default. Set a path or a Git URL to build it from somewhere else.
HOMEPAD_API_CONTEXT=./api

# --- Sessions / cookies ---------------------------------------------------
# COOKIE_SECURE MUST be false for plain-HTTP localhost, or sign-in won't stick.
# That goes for password sign-in and single sign-on.
# Set it true only when serving Homepad over HTTPS (e.g. behind a TLS proxy).
COOKIE_SECURE=false

# --- Registration policy --------------------------------------------------
#   invite_only  — the default. The first account signs up and is the admin.
#                  After that, adults join through an invite link an admin
#                  makes in Administration → Accounts, and kids are added there.
#   open         — anyone who can open Homepad can make an account. Accounts
#                  shows a warning while this is on.
HOMEPAD_REGISTRATION=invite_only

# --- Account limit (optional) ---------------------------------------------
# The most accounts (admin, member and kid) plus pending invites allowed.
# Unset or 0 means no limit. The public demo uses 12.
# HOMEPAD_MAX_ACCOUNTS=12

# --- Sign-in limits (optional) --------------------------------------------
# Proxies to believe for the client address (comma-separated); empty: everyone shares one limit.
# HOMEPAD_TRUSTED_PROXIES=web

# --- Gatus (status tiles) -------------------------------------------------
# Where the api polls status from. Leave empty to run without status dots.
# Quickstart: COMPOSE_PROFILES=gatus starts a bundled Gatus; then set
# GATUS_BASE_URL=http://gatus:8080 and edit the gatus-config block in compose.yaml.
# compose.build.yaml always runs Gatus, configured by deploy/compose/gatus.yaml.
# COMPOSE_PROFILES=gatus
GATUS_BASE_URL=http://gatus:8080
# A check that SUCCEEDED but took longer than this reads DEGRADED ("Slow" on the
# tile). 0 disables the derivation.
GATUS_DEGRADED_MS=1000
# Override the Gatus image/tag if you prefer Docker Hub (twinproduction/gatus).
GATUS_IMAGE=ghcr.io/twin/gatus:latest

# --- OIDC / SSO (OPTIONAL) ------------------------------------------------
# Homepad runs fully on local accounts with OIDC_ENABLED=false. To enable SSO,
# set it true and fill in your provider's values; leave them blank otherwise.
# The provider must mark each user's email as verified (email_verified), or
# Homepad refuses the sign-in. With invite_only, single sign-on makes accounts
# only for OIDC_ADMIN_GROUP and OIDC_MEMBER_GROUP. See docs/single-sign-on.md.
OIDC_ENABLED=false
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
OIDC_ADMIN_GROUP=
# New people in this group get a member account on their first sign-in.
OIDC_MEMBER_GROUP=
